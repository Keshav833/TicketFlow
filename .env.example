# Django
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
THROTTLE_ENABLED=1

# PostgreSQL
DB_NAME=ticketflow
DB_USER=ticketflow
DB_PASSWORD=replace-with-a-strong-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (database 0: Celery broker, 1: result backend, 2: Django cache)
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Razorpay test credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (console backend by default; configure SMTP to send real email)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=TicketFlow <no-reply@ticketflow.com>